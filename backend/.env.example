# Copy to .env and adjust as needed. All values shown are the defaults.

# --- App ---
APP_NAME=AIVOA Deviation Intake API
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins the frontend is served from) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (required: PostgreSQL) ---
# This is the documented/final configuration. Create the database first
# (see README "Local development" section), then set this to match:
DATABASE_URL=postgresql+psycopg2://aivoa:password@localhost:5432/aivoa_deviations

# MySQL is supported as an alternative if you install pymysql instead of
# psycopg2-binary in requirements.txt:
# DATABASE_URL=mysql+pymysql://aivoa:password@localhost:3306/aivoa_deviations

# SQLite fallback — local-dev/demo ONLY, zero setup, not the documented
# configuration. Uncomment only if you don't have Postgres available yet:
# DATABASE_URL=sqlite:///./deviations.db

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt

# --- AI service ---
# Real AI is the default for the submission. Set false only for offline/local
# testing when you intentionally want the deterministic stub service.
AI_SERVICE_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
